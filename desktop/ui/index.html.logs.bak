<!doctype html>
<html lang="en" dir="ltr" data-theme="midnight" data-font-size="medium">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="app-version" content="2.50.0">
  <meta name="color-scheme" content="dark light">
  <title>ChatBridge · 2.50.0</title>
  <link rel="stylesheet" href="style.css">
  <script defer src="i18n.js"></script>
  <script defer src="app.js"></script>
</head>
<body>
  <header id="header" class="app-header">
    <button id="sidebarToggle" class="icon-button" title="Toggle sidebar" aria-label="Toggle sidebar" aria-expanded="true">☰</button>
    <a class="wordmark" href="#" aria-label="ChatBridge home"><span class="brand-symbol">⌘</span> Chat<span>Bridge</span><small>2.50.0</small></a>
    <span class="header-divider"></span>
    <button id="connectionChip" class="connection-chip" title="Reveal internal browser"><span class="connection-dot"></span><span id="connectionText" data-i18n="not_connected">NOT CONNECTED</span></button>
    <label class="sr-only" for="modelSelect" data-i18n="model">Model</label><select id="modelSelect" class="model-select" aria-label="Model"><option value="chatgpt">ChatGPT</option></select>
    <div class="project-context"><span>⌑</span><span id="projectTitle" data-i18n="no_project">No project</span><span id="branchLabel" class="branch-label" hidden></span></div>
    <div class="header-actions"><button id="ibOpenBtn" class="browser-button" title="Open internal browser"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/></svg><span data-i18n="internal_browser">Internal Browser</span><span class="connection-dot"></span></button><button id="whatsNewBtn" class="icon-button" title="What's new">✧</button><button id="rightSidebarToggle" class="icon-button" title="Toggle tools sidebar" aria-label="Toggle tools sidebar" aria-expanded="true">☰</button><button id="settingsBtn" class="icon-button" title="Settings" aria-label="Settings">⚙</button></div>
  </header>
  <main id="workspace" class="workspace">
    <aside id="sidebar" class="sidebar">
      <button id="newChatBtn" class="new-chat"><span>＋</span><span class="sidebar-copy" data-i18n="new_chat">New chat</span><kbd class="sidebar-copy">Ctrl N</kbd></button>
      <div class="sidebar-section sidebar-copy"><span data-i18n="workspace">WORKSPACE</span><button id="projectAttachBtn" class="icon-button small" title="Attach project">＋</button></div>
      <button id="projectBtn" class="sidebar-item"><span>⌑</span><span id="sidebarProject" class="sidebar-copy" data-i18n="attach_project">Attach a project</span></button>
      <div id="workspaceList" class="workspace-list"></div>

      <div class="sidebar-section sidebar-copy"><span data-i18n="conversations">CONVERSATIONS</span><button id="syncChatsBtn" class="icon-button small" title="Refresh web conversations">↻</button></div>
      <nav id="chatList" class="chat-list" aria-label="Conversations"></nav>
      <div class="sidebar-bottom"><div class="access-row"><span>◇</span><span class="sidebar-copy" data-i18n="full_access">Full access</span><button id="fullAccessSwitch" role="switch" aria-checked="true" class="switch" aria-label="Full access"></button></div><p id="accessWarning" class="access-warning sidebar-copy" data-i18n="access_warning">Writes and commands run without approval. Only use trusted chats.</p><button id="sidebarSettingsBtn" class="sidebar-item"><span>⚙</span><span class="sidebar-copy" data-i18n="settings">Settings</span></button><div class="sidebar-footer sidebar-copy"><span class="local-dot"></span><span data-i18n="local_workspace">Local workspace</span></div></div>
    </aside>
    <div id="leftSplitter" class="splitter" role="separator" aria-label="Resize sidebar" aria-orientation="vertical" tabindex="0"></div>
    <section id="chatPanel" class="chat-panel" aria-label="Chat">
      <div class="chat-toolbar"><div><span class="eyebrow" data-i18n="conversation">CONVERSATION</span><h1 id="chatTitle" data-i18n="new_conversation">New conversation</h1></div><div class="toolbar-actions"><button id="olderBtn" class="icon-button" title="Load older messages" hidden>↑</button><button id="resetLayoutBtn" class="icon-button" title="Default layout">⊞</button><button id="hideBrowserBlock" class="icon-button" title="Toggle tools dock" aria-label="Toggle tools dock">▥</button></div></div>
      <div id="limitBanner" class="limit-banner" role="alert" hidden></div>
      <div id="chatStream" class="chat-stream" aria-live="polite" aria-relevant="additions text">
        <section id="welcome" class="welcome"><div class="welcome-mark">⌘</div><p class="eyebrow" data-i18n="your_local_bridge">YOUR LOCAL BRIDGE</p><h2 data-i18n="welcome_title">A conversation. A workspace.<br>Everything connected.</h2><p data-i18n="welcome_description">Chat with your preferred web model, work with local files, and keep every command in view.</p><div class="welcome-actions"><button id="welcomeBrowserBtn" class="primary" data-i18n="open_browser">Open internal browser</button><button id="welcomeProjectBtn" class="secondary" data-i18n="attach_project">Attach a project</button></div><div class="welcome-note"><span>↗</span><span data-i18n="login_hint">Sign in once in the internal browser. Your session stays on this device.</span></div></section>
      </div>
      <div id="approvalHost" class="approval-host" aria-live="polite"></div>
      <div class="composer-wrap"><div id="attachmentHost" class="attachment-host"></div><form id="composerForm" class="composer"><label class="sr-only" for="composerInput" data-i18n="message">Message</label><textarea id="composerInput" rows="2" placeholder="Ask, build, or explore your project…" data-i18n-placeholder="composer_placeholder"></textarea><div class="composer-bottom"><button id="attachBtn" type="button" class="icon-button" title="Attach file" aria-label="Attach file">＋</button><span id="composerStatus" class="composer-status" data-i18n="ready">Ready when you are</span><button id="sendBtn" type="submit" class="send-button" aria-label="Send message"><span id="sendIcon">↑</span></button></div></form><input id="attachmentInput" type="file" hidden><div class="composer-hint"><span data-i18n="composer_hint">Enter to send · Shift Enter for a new line</span><span id="chatModelHint">ChatGPT · Web</span></div></div>
    </section>
    <div id="centerSplitter" class="splitter" role="separator" aria-label="Resize chat and browser" aria-orientation="vertical" tabindex="0"></div>
    <section id="browserPane" class="browser-pane">
          <form id="urlForm" class="browser-navigation"><button type="button" data-nav="back" class="icon-button small" title="Back">←</button><button type="button" data-nav="forward" class="icon-button small" title="Forward">→</button><button type="button" data-nav="reload" class="icon-button small" title="Reload">↻</button><label class="sr-only" for="browserUrl">URL</label><input id="browserUrl" value="https://chatgpt.com/" aria-label="Browser URL" dir="ltr" spellcheck="false"><button type="submit" class="icon-button small" title="Navigate">↗</button></form>
          <div id="ibDock" class="ib-dock"><div id="ibDockEmpty" class="dock-empty"><div class="browser-outline"><svg viewBox="0 0 100 76" aria-hidden="true"><rect x="6" y="6" width="88" height="64" rx="7"/><path d="M6 24h88M16 15h1m7 0h1m7 0h1"/><circle cx="50" cy="47" r="14"/><path d="M36 47h28M50 33c8 8 8 20 0 28-8-8-8-20 0-28Z"/></svg></div><span class="eyebrow" data-i18n="browser_workspace">BROWSER WORKSPACE</span><h2 data-i18n="browser_empty_title">Your model lives here.</h2><p id="browserEmptyDescription" data-i18n="browser_empty_description">Open the native browser and sign in to your preferred chat service.</p><button id="ibDockOpen" class="primary" data-i18n="open_browser">Open internal browser</button><span id="demoNotice" class="demo-notice" data-i18n="demo_notice">Preview only · Native bridge unavailable</span></div></div>
          <div class="browser-foot"><span class="connection-dot"></span><span id="browserState" data-i18n="not_connected">NOT CONNECTED</span><button id="reinjectBtn" class="icon-button small" title="Reinject page agent">↻</button><button id="browserLogBtn" class="icon-button small" title="View browser log">≡</button></div><pre id="bbLog" class="browser-log" aria-label="Browser log">Waiting for the native browser bridge.</pre>
        </section>
        
        <div id="rightSplitter" class="splitter" role="separator" aria-label="Resize tools dock" aria-orientation="vertical" tabindex="0"></div>
    <aside id="rightBlock" class="right-block" aria-label="Tools dock">
      <div class="dock-tabs" role="tablist" aria-label="Workspace tools"><button class="dock-tab active" data-tab="files" role="tab" aria-selected="true"><span>▱</span><span data-i18n="explorer">Explorer</span></button><button class="dock-tab" data-tab="terminal" role="tab" aria-selected="false"><span>›_</span><span data-i18n="terminal">Terminal</span></button><button class="dock-tab" data-tab="git" role="tab" aria-selected="false"><span>⑂</span><span>Git</span></button><button class="dock-tab" data-tab="file" role="tab" aria-selected="false"><span>≡</span><span>FILE</span></button></div>
      <div id="rightBody" class="right-body">
        <section id="utilityPane" class="utility-pane">
          <div id="browserTool" class="tool-panel active" data-panel="browser"><div class="tool-header"><span data-i18n="session">SESSION</span><span class="badge" data-i18n="local">LOCAL</span></div><div class="session-card"><span class="session-icon">◇</span><h3 data-i18n="a_private_workspace">A private workspace</h3><p data-i18n="session_description">Your files stay local. You choose what the model can read, write, and run.</p></div><div class="session-steps"><div><span>01</span><p data-i18n="step_connect">Open browser & sign in</p></div><div><span>02</span><p data-i18n="step_project">Attach your workspace</p></div><div><span>03</span><p data-i18n="step_message">Start a conversation</p></div></div><button id="sessionProjectBtn" class="secondary" data-i18n="attach_project">Attach a project</button><div class="tool-tip" data-i18n="dock_tip">Drag either divider to make room for your work.</div></div>
          <div id="filesPanel" class="tool-panel" data-panel="files" hidden><div class="tool-header"><span data-i18n="explorer">EXPLORER</span><button id="refreshFilesBtn" class="icon-button small" title="Refresh files">↻</button></div><input id="fileFilter" class="filter-input" placeholder="Find a file…" data-i18n-placeholder="file_filter" aria-label="Filter files"><div id="fileTree" class="file-tree"></div><div id="filesEmpty" class="panel-empty"><span>▱</span><p data-i18n="files_empty">Attach a project to explore and edit local files.</p><button id="filesAttachBtn" class="secondary" data-i18n="attach_project">Attach a project</button><button id="filesFolderBtn" class="text-button" data-i18n="create_folder">Create chat folder</button></div></div>
          <div id="terminalPanel" class="tool-panel" data-panel="terminal" hidden><div class="tool-header"><span data-i18n="terminal">TERMINAL</span><select id="terminalSession" aria-label="Terminal session"><option value="" data-i18n="new_session">New session</option></select></div><pre id="terminalOutput" class="terminal-output" aria-live="polite">No command has been run.</pre><div id="terminalMeta" class="terminal-meta"></div><form id="terminalForm" class="terminal-form"><label class="sr-only" for="terminalCommand">Command</label><input id="terminalCommand" placeholder="Enter a command…" data-i18n-placeholder="command_placeholder" dir="ltr"><button class="primary" type="submit" data-i18n="run">Run</button></form><div class="button-row"><button id="terminalKillBtn" class="secondary danger-text" data-i18n="kill">Kill</button><button id="terminalRerunBtn" class="secondary" data-i18n="rerun">Rerun</button></div><button id="terminalSendBtn" class="secondary" data-i18n="send_result">Send result to chat</button></div>
          <div id="gitPanel" class="tool-panel" data-panel="git" hidden><div class="tool-header"><span id="gitBranch">GIT</span><button id="gitRefreshBtn" class="icon-button small" title="Refresh Git status">↻</button></div><div class="button-row"><button data-git="pull" class="secondary">↓ Pull</button><button data-git="push" class="secondary">↑ Push</button></div><select id="gitBranches" aria-label="Git branch"><option value="">Branches…</option></select><div id="gitChanges" class="git-changes"></div><textarea id="commitMessage" rows="3" placeholder="Commit message" data-i18n-placeholder="commit_message"></textarea><div class="commit-template"><input id="jiraKey" placeholder="PROJ-123" aria-label="Jira issue key"><button id="jiraTemplateBtn" class="text-button" data-i18n="jira_template">Jira template</button></div><button id="gitCommitBtn" class="primary" data-i18n="commit">Commit staged</button><pre id="gitDiff" class="git-diff" aria-label="Git diff"></pre></div>
          <div id="filePanel" class="tool-panel editor-panel" data-panel="file" hidden><div class="tool-header"><span id="editorFilename" data-i18n="no_file">No file open</span><span id="editorDirty" class="dirty-dot" hidden title="Unsaved changes">●</span></div><div id="editorNotice" class="editor-notice" hidden></div><div class="editor-toolbar"><button id="editorSaveBtn" class="primary" data-i18n="save">Save</button><kbd>Ctrl S</kbd><button id="editorRevealBtn" class="icon-button" title="Reveal in file manager">↗</button></div><div id="editorArea" class="editor-area"><pre id="lineNumbers" class="line-numbers">1</pre><div class="editor-stack"><pre id="codeHighlight" class="code-highlight" aria-hidden="true"></pre><textarea id="fileEditor" class="file-editor" spellcheck="false" aria-label="File editor" dir="ltr" disabled></textarea></div></div><div id="editorStatus" class="editor-status" data-i18n="open_file_hint">Choose a file from Explorer.</div></div>
        </section>
      </div>
    </aside>
  </main>
  <footer class="statusbar"><div><span class="brand-status">⌘</span><span id="globalStatus" data-i18n="local_ready">Local interface ready</span></div><div><span id="bridgeMode" data-i18n="preview">PREVIEW</span><span data-i18n="utf8">UTF-8</span><span>2.50.0</span></div></footer>
  <div id="toastHost" class="toast-host" role="status" aria-live="polite"></div>
  <dialog id="settingsModal" class="settings-modal"><div class="settings-shell"><div class="settings-heading"><div><span class="eyebrow">CHATBRIDGE</span><h2 data-i18n="settings">Settings</h2></div><button id="settingsCloseBtn" class="icon-button" aria-label="Close settings">×</button></div><div class="settings-body"><nav class="settings-nav" aria-label="Settings categories"><button class="active" data-category="general" data-i18n="general">General</button><button data-category="appearance" data-i18n="appearance">Appearance</button><button data-category="models" data-i18n="models">Models</button><button data-category="internal-browser" data-i18n="internal_browser">Internal Browser</button><button data-category="provider" data-i18n="provider">Provider Server</button><button data-category="agent-rules" data-i18n="agent_rules">Agent Rules</button></nav><div class="settings-content">
    <section data-settings="general"><h3 data-i18n="general">General</h3><p class="section-description" data-i18n="general_description">Your workspace, your preferences.</p><div class="setting-row"><div><label for="languageSelect" data-i18n="language">Interface language</label><small data-i18n="language_description">English by default. Persian supports right-to-left text.</small></div><select id="languageSelect"><option value="en">English</option><option value="fa">فارسی</option></select></div><div class="setting-row"><div><label for="approvalTimeout" data-i18n="approval_timeout">Approval timeout</label><small data-i18n="seconds">Seconds before an unanswered request is denied.</small></div><input id="approvalTimeout" type="number" min="10" max="600" value="120"></div><div class="setting-row"><div><span data-i18n="logs">Application logs</span><small data-i18n="logs_description">Inspect errors or export a diagnostic archive.</small></div><div class="button-row"><button id="logsViewBtn" class="secondary" data-i18n="view">View</button><button id="logsExportBtn" class="secondary" data-i18n="export">Export</button></div></div><pre id="settingsLogs" class="settings-logs" hidden></pre></section>
    <section data-settings="appearance" hidden><h3 data-i18n="appearance">Appearance</h3><p class="section-description" data-i18n="appearance_description">Make a little more room for your ideas.</p><div class="setting-row"><div><label for="themeSelect" data-i18n="theme">Theme</label><small data-i18n="theme_description">Six carefully balanced palettes.</small></div><select id="themeSelect"><option value="midnight">Midnight</option><option value="graphite">Graphite</option><option value="nord">Nord</option><option value="forest">Forest</option><option value="light">Daylight</option><option value="sepia">Paper</option></select></div><div id="themeSwatches" class="theme-swatches" aria-hidden="true"><span style="--swatch:#8982f5"></span><span style="--swatch:#b6b5bc"></span><span style="--swatch:#88c0d0"></span><span style="--swatch:#93b98c"></span><span style="--swatch:#6559cd"></span><span style="--swatch:#a47641"></span></div><div class="setting-row"><div><label for="fontSizeSelect" data-i18n="font_size">Text size</label><small data-i18n="font_description">Applies to conversations and workspace tools.</small></div><select id="fontSizeSelect"><option value="small">Small · 12px</option><option value="medium">Medium · 13px</option><option value="large">Large · 15px</option><option value="extra-large">Extra large · 17px</option></select></div><div class="setting-row"><div><label for="codeFont" data-i18n="code_font">Code font</label><small data-i18n="code_font_description">A locally installed monospace font.</small></div><select id="codeFont"><option value="Cascadia Code">Cascadia Code</option><option value="Consolas">Consolas</option><option value="Courier New">Courier New</option><option value="monospace">System monospace</option></select></div><div class="setting-row"><div><span data-i18n="layout">Workspace layout</span><small data-i18n="layout_description">Restore both dividers and the sidebar.</small></div><button id="settingsLayoutBtn" class="secondary" data-i18n="reset_layout">Default layout</button></div></section>
    <section data-settings="models" hidden><h3 data-i18n="models">Models</h3><p class="section-description" data-i18n="models_description">Web chat services. Sign in through the internal browser; no API key is needed.</p><div id="modelsList"></div><form id="customModelForm" class="custom-model-form"><h4 data-i18n="add_model">Add a web model</h4><label for="customModelName" data-i18n="name">Name</label><input id="customModelName" required placeholder="My model"><label for="customModelUrl">Home URL</label><input id="customModelUrl" required type="url" placeholder="https://chat.example.com" dir="ltr"><button class="primary" type="submit" data-i18n="add_model">Add a web model</button></form></section>
    <section id="browserSettings" data-settings="internal-browser" hidden><h3 data-i18n="internal_browser">Internal Browser</h3><p class="section-description" data-i18n="browser_settings_description">One native browser, docked in your workspace.</p><div class="setting-row"><div><span data-i18n="driver_status">Driver status</span><small id="settingsDriverStatus" data-i18n="not_connected">NOT CONNECTED</small></div><div class="button-row"><button id="settingsBrowserOpen" class="secondary" data-i18n="open">Open</button><button id="settingsBrowserClose" class="secondary" data-i18n="close">Close</button></div></div><div class="setting-row"><div><span data-i18n="persistent_login">Persistent login</span><small data-i18n="profile_description">Sessions stay on this device. Clearing the profile signs you out.</small></div><button id="profileResetBtn" class="secondary danger-text" data-i18n="clear_profile">Clear profile</button></div><div class="setting-row"><div><span data-i18n="dock_behavior">Dock on startup</span><small data-i18n="dock_description">Show the tools block when the app starts.</small></div><button id="dockStartupSwitch" role="switch" aria-checked="true" class="switch" aria-label="Dock on startup"></button></div><div class="setting-row"><div><label for="wsPort" data-i18n="ws_port">Local bridge port</label><small data-i18n="restart_required">A restart is required after changing the port.</small></div><input id="wsPort" type="number" min="1024" max="65535" value="8787"></div></section>
    <section data-settings="provider" hidden><h3 data-i18n="provider">Provider Server</h3><p class="section-description" data-i18n="provider_description">Expose web models to OpenAI-compatible local clients. Disabled by default.</p><div class="setting-row"><div><span data-i18n="enable_provider">Enable provider</span><small id="providerStatus" data-i18n="provider_disabled">Server is disabled.</small></div><button id="providerSwitch" role="switch" aria-checked="false" class="switch" aria-label="Enable provider"></button></div><div class="setting-row"><label for="providerPort" data-i18n="port">Port</label><input id="providerPort" type="number" min="1024" max="65535" value="8788"></div><div class="setting-row"><label for="providerTimeout" data-i18n="provider_timeout">Request timeout (seconds)</label><input id="providerTimeout" type="number" min="30" max="3600" value="600"></div><div class="setting-row"><label for="providerKey" data-i18n="provider_key">Local access key</label><input id="providerKey" type="password" readonly aria-label="Local provider access key"></div><p id="providerEndpoint" class="endpoint" dir="ltr">http://127.0.0.1:8788/v1</p></section>
    <section data-settings="agent-rules" hidden><h3 data-i18n="agent_rules">Agent Rules</h3><p class="section-description" data-i18n="rules_description">A short, first-person note added when a workspace is attached. Edit what your model sees.</p><div class="setting-row"><div><span data-i18n="inject_rules">Include agent rules</span><small data-i18n="rules_master_description">Turn off all rule injection without losing your edits.</small></div><button id="agentRulesMaster" role="switch" aria-checked="true" class="switch" aria-label="Include agent rules"></button></div><div id="agentRulesList" class="rules-list"></div><div class="rules-actions"><button id="addRuleBtn" class="secondary" data-i18n="add_rule">＋ Add rule</button><button id="resetRulesBtn" class="text-button danger-text" data-i18n="reset_rules">Reset defaults</button><button id="saveRulesBtn" class="primary" data-i18n="save_rules">Save rules</button></div><div class="preview-heading"><h4 data-i18n="injected_preview">Injected message preview</h4><button id="rulesPreviewBtn" class="secondary" data-i18n="preview_message">Preview message</button></div><label class="sr-only" for="rulesPreviewInput" data-i18n="preview_prompt">Example message</label><textarea id="rulesPreviewInput" rows="2" placeholder="Example message to preview…" data-i18n-placeholder="preview_prompt"></textarea><pre id="rulesPreview" class="rules-preview" aria-live="polite"></pre><p id="rulesSaveStatus" class="muted" aria-live="polite"></p></section>
  </div></div></div></dialog>
  <dialog id="confirmModal" class="confirm-modal"><h3 id="confirmTitle"></h3><p id="confirmText"></p><div class="button-row"><button id="confirmCancel" class="secondary" data-i18n="cancel">Cancel</button><button id="confirmAccept" class="primary" data-i18n="confirm">Confirm</button></div></dialog>
</body>
</html>
