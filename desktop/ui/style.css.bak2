nt-bg);color:var(--accent)}.tree-folder summary{cursor:pointer;list-style:none}.tree-folder summary::before{content:'›';font-size:13px;width:7px;color:var(--subtle)}.tree-folder[open]>summary::before{content:'⌄'}.tree-children{padding-left:12px}.tree-hidden summary{opacity:.6}.panel-empty{display:flex;flex-direction:column;align-items:center;text-align:center;margin:35px 0;font-size:10px;line-height:1.8;color:var(--subtle)}.panel-empty>span{font-size:31px;color:var(--muted)}.panel-empty .secondary{font-size:10px;margin-top:12px}.terminal-output{flex:1;min-height:130px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;direction:ltr;text-align:left;font:10px/1.65 var(--code-font);padding:10px;margin:0 -5px;background:var(--bg);border-radius:5px}.terminal-meta,.editor-status{font-size:9px;color:var(--subtle);overflow-wrap:anywhere}.terminal-form{display:flex;gap:5px;flex-wrap:wrap}.terminal-form input{width:100%;font:10px var(--code-font);height:30px}.terminal-form button{width:100%}.terminal-panel button{font-size:10px}.tool-header select{font-size:9px;height:24px;max-width:135px}.ansi-red{color:var(--red)}.ansi-green{color:var(--green)}.ansi-yellow{color:var(--amber)}.ansi-blue{color:#88a9e2}.ansi-magenta{color:var(--accent)}.ansi-cyan{color:#7fc4ce}.ansi-white{color:var(--text)}.ansi-black{color:var(--subtle)}.ansi-bold{font-weight:700}.stderr{color:var(--red)}.git-changes{font:10px var(--code-font);overflow:auto;max-height:35vh}.git-change{padding:9px 0;border-bottom:1px solid var(--border)}.git-change-path{display:flex;align-items:center;gap:6px;overflow-wrap:anywhere;margin-bottom:5px}.git-change-path>span:first-child{color:var(--amber)}.git-change .button-row button{font:8px 'Segoe UI',sans-serif;padding:4px;border:1px solid var(--border);border-radius:4px}.git-diff{font:9px/1.6 var(--code-font);direction:ltr;white-space:pre;overflow:auto;min-height:60px;flex:1;color:var(--muted)}#commitMessage{width:100%;font-size:10px;min-height:65px}#gitBranches{font-