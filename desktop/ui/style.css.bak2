ox-shadow:0 25px 100px #0006}dialog::backdrop{background:#080911bc;backdrop-filter:blur(4px)}.settings-modal{width:min(1000px,94vw);height:min(790px,92vh);max-width:none;max-height:none}.settings-shell{display:flex;flex-direction:column;height:100%;overflow:hidden}.settings-heading{display:flex;align-items:center;justify-content:space-between;padding:24px 29px 21px;border-bottom:1px solid var(--border);flex:none}.settings-heading h2{font-size:23px;font-weight:500;letter-spacing:-.5px;margin:3px 0 0}.settings-body{display:flex;flex:1;min-height:0;direction:ltr}.settings-nav{width:192px;flex:none;padding:22px 12px;background:var(--bg);border-right:1px solid var(--border)}.settings-nav button{width:100%;display:block;text-align:start;border-radius:6px;padding:11px 13px;margin-bottom:3px;color:var(--muted);font-size:12px}.settings-nav button.active{background:var(--accent-bg);color:var(--accent)}.settings-content{flex:1;overflow:auto;padding:29px 37px;min-width:0}.settings-content h3{font-size:19px;font-weight:500;margin:0 0 7px}.section-description{color:var(--muted);font-size:12px;line-height:1.8;margin:0 0 27px}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:23px;padding:18px 0;border-bottom:1px solid var(--border);font-size:12px}.setting-row small{display:block;color:var(--subtle);font-size:10px;margin-top:5px;line-height:1.65;max-width:330px}.setting-row input[type="number"]{width:95px}.setting-row>select{width:170px;flex:none;font-size:11px}.setting-row .secondary{font-size:10px}.setting-row>input[type="password"]{width:210px;font:10px var(--code-font)}.theme-swatches{display:flex;gap:10px;padding:18px 0 6px}.theme-swatches span{width:31px;height:18px;background:var(--swatch);border:3px solid var(--surface-3);border-radius:5px}.custom-model-form{display:flex;flex-direction:column;gap:8px;max-width:370px;margin-top:25px}.custom-model-form h4{font-size:13px;font-weight:500;margin:0 0 8px}.custom-model-form label{font-size:10px;color:var(--muted)}.custom-model-form .primary{align-self:flex-start;margin-top:8px}.model-row{padding:16px 0;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;font-size:12px}.model-row>div{flex:1;min-width:0}.model-row small{display:block;color:var(--subtle);font-size:10px;overflow-wrap:anywhere}.model-row .badge{font-size:8px}.rules-list{margin-top:20px}.rule-row{display:flex;align-items:flex-start;gap:10px;padding:14px 0;border-bottom:1px solid var(--border)}.rule-row .switch{margin-top:8px}.rule-row textarea{flex:1;font-size:11px;min-height:79px;line-height:1.75;background:var(--bg)}.rule-row .icon-button{margin-top:2px}.rule-meta{font-size:9px;color:var(--subtle);margin-bottom:4px}.rule-content{flex:1;display:flex;flex-direction:column}.rule-row.disabled textarea{opacity:.55}.rules-actions{display:flex;align-items:center;gap:13px;margin:17px 0 30px;flex-wrap:wrap}.rules-actions .primary{margin-inline-start:auto}.rules-actions button{font-size:10px}.preview-heading{display:flex;align-items:center;justify-content:space-between;gap:10px}.preview-heading h4{font-size:12px;font-weight:500}.preview-heading button{font-size:10px}#rulesPreviewInput{width:100%;font-size:11px}.rules-preview,.settings-logs{white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.8 var(--code-font);background:var(--bg);padding:16px;border:1px solid var(--border);border-radius:7px;max-height:300px;overflow:auto;min-height:90px}.endpoint{font:11px var(--code-font);color:var(--accent);margin-top:25px}.confirm-modal{padding:25px;width:410px;max-width:90vw}.confirm-modal h3{font-size:17px;font-weight:500;margin:0 0 12px}.confirm-modal p{font-size:12px;color:var(--muted);line-height:1.8;overflow-wrap:anywhere;white-space:pre-wrap}.confirm-modal .button-row{margin-top:25px}.dragging-layout,.dragging-layout *{cursor:col-resize!important;user-select:none!important}.dragging-layout .ib-dock{pointer-events:none}
html[dir="rtl"] .sidebar,html[dir="rtl"] .chat-panel,html[dir="rtl"] .utility-pane,html[dir="rtl"] .settings-content,html[dir="rtl"] .settings-nav,html[dir="rtl"] .confirm-modal{direction:rtl;text-align:right}html[dir="rtl"] .settings-nav{border-right:1px solid var(--border)}html[dir="rtl"] .chat-item,html[dir="rtl"] .sidebar-item,html[dir="rtl"] .new-chat{direction:rtl}html[dir="rtl"] .access-row .switch{margin-left:0;margin-right:auto}html[dir="rtl"] .new-chat kbd{margin-left:0;margin-right:auto}html[dir="rtl"] .thinking{margin-left:0;margin-right:33px}html[dir="rtl"] .settings-heading{direction:rtl}html[dir="rtl"] .composer-hint{font-size:10px}html[dir="rtl"] .file-tree,html[dir="rtl"] .editor-area{direction:ltr;text-align:left}
@media(max-width:1190px){:root{--sidebar-width:175px;--right-width:480px;--browser-width:255px}.app-header{gap:7px}.header-divider,.wordmark small{display:none}.connection-chip{font-size:8px;padding:3px}.project-context{max-width:150px}.chat-toolbar{padding:17px 20px}.chat-stream{padding:23px 20px}.composer-wrap{padding:10px 18px 17px}.dock-tab{padding:0 6px;font-size:9px}.dock-tab>span:first-child{display:none}.welcome h2{font-size:25px}.welcome-actions{gap:7px}.welcome-actions button{font-size:10px;padding:8px 9px}}
@media(max-width:960px){:root{--sidebar-width:155px;--right-width:380px;--browser-width:205px}.project-context{display:none}.wordmark{font-size:14px}.brand-symbol{font-size:21px}.connection-chip{max-width:120px}.browser-button{font-size:10px;gap:5px;padding:0 7px}.header-actions{gap:3px}.chat-panel{min-width:280px}.welcome{margin-top:40px}.welcome h2{font-size:23px}.dock-empty{padding:15px 10px}.dock-empty h2{font-size:14px}.dock-empty p{font-size:10px}.dock-empty .primary{font-size:9px;padding:7px}.session-card{margin-top:10px}.session-steps p{font-size:9px}.tool-panel{padding:0 9px 12px}.tool-header{margin:0 -9px 3px}.tool-panel .secondary{white-space:normal}.settings-nav{width:160px}.settings-content{padding:25px}.composer-hint{font-size:8px}.browser-navigation button[data-nav="forward"]{display:none}}
@media(max-width:760px){.sidebar:not(.collapsed){width:155px}.right-block{min-width:180px}.browser-pane{min-width:130px}.utility-pane{min-width:110px}.connection-chip{display:none}.header-actions .icon-button{width:27px}.wordmark small{display:none}.app-header{padding:0 7px;gap:5px}.browser-button{font-size:9px}.browser-button>span:not(.connection-dot){max-width:86px;overflow:hidden;text-overflow:ellipsis}.model-select{min-width:85px;max-width:110px}.settings-modal{width:96vw;height:94vh}.settings-heading{padding:18px}.settings-nav{width:130px;padding:15px 7px}.settings-nav button{font-size:10px;padding:10px 8px}.settings-content{padding:20px 17px}.setting-row{gap:12px;align-items:flex-start}.setting-row>select{width:120px}.section-description{font-size:11px}.welcome h2{font-size:21px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}

/* Message actions, project ownership and attachment previews. */
.message-actions{display:flex;gap:6px;margin:8px 0 0 33px;opacity:.72}.message-action{font-size:12px;line-height:1;color:var(--muted);border:1px solid var(--border);border-radius:5px;padding:4px 7px;background:var(--surface-2)}.message-action.icon-only{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;padding:0;font-size:13px}.message-action:hover{color:var(--accent);border-color:var(--accent)}.chat-project{display:block;color:var(--accent);font-size:8px;line-height:1.2;margin-top:2px;overflow:hidden;text-overflow:ellipsis;max-width:135px}.message-project{font-size:9px;color:var(--accent);background:var(--accent-bg);border-radius:4px;padding:2px 6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px}.message-file{display:flex;align-items:flex-start;gap:7px;flex-wrap:wrap;margin:6px 0}.message-file img{display:block;max-width:min(420px,100%);max-height:280px;border:1px solid var(--border);border-radius:8px;background:var(--surface);object-fit:contain}.file-preview{width:min(100%,680px);max-height:280px;overflow:auto;margin:0;padding:13px 15px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text);font:11px/1.7 var(--code-font);direction:ltr;text-align:left;white-space:pre;tab-size:4;box-shadow:inset 3px 0 0 var(--accent-strong)}.message-file .file-chip{cursor:pointer}.message-file .file-chip:hover{border-color:var(--accent);color:var(--accent)}

.dock-collapse{margin-inline-start:auto;color:var(--accent);border-left:1px solid var(--border);border-radius:0;min-width:28px;width:30px}
.panel-collapse{margin-inline-start:auto;color:var(--accent)}
.utility-pane[hidden],.browser-pane[hidden]{display:none!important}
