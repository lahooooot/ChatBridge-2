/* ChatBridge 2.50.0 — native, build-free workspace. Physical docking stays right in RTL. */
:root{--bg:#111218;--surface:#17181f;--surface-2:#1c1d26;--surface-3:#242631;--hover:#292b38;--border:#2b2d39;--text:#e5e5ec;--muted:#858796;--subtle:#666977;--accent:#a49aff;--accent-strong:#8174e8;--accent-bg:#2b2642;--green:#84c8ae;--red:#f18d98;--amber:#dcb880;--font-size:13px;--code-font:'Cascadia Code',Consolas,'DejaVu Sans Mono',monospace;--right-width:560px;--browser-width:305px;--sidebar-width:204px;color-scheme:dark}
.workspace-list{display:flex;flex-direction:column;gap:2px;margin:2px 0 4px}
.workspace-row{display:flex;align-items:center;gap:6px;padding:5px 8px;border-radius:6px;color:var(--text);background:transparent}
.workspace-row:hover{background:var(--hover)}
.workspace-row.active{background:var(--accent-bg);color:var(--accent)}
.workspace-row .ws-name{flex:1 1 auto;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.92em;text-align:left;background:none;border:0;color:inherit;cursor:pointer;padding:0}
.workspace-row .ws-act{width:22px;height:22px;font-size:13px;border:0;background:transparent;color:var(--muted);border-radius:5px;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;opacity:0}
.workspace-row:hover .ws-act{opacity:1}
.workspace-row .ws-act:hover{background:var(--surface-2);color:var(--accent)}
.workspace-row .ws-act.ws-del:hover{color:var(--red)}
.dock-collapse-cluster{display:flex;align-items:center;gap:4px;margin-left:auto;flex:0 0 auto}
.dock-collapse-cluster .dock-collapse{border:1px solid var(--border);border-radius:6px;background:var(--surface-2)}

/* ---- Requested fixes: compact collapse buttons + code highlight ---- */
.dock-tabs{position:relative;flex-wrap:nowrap;overflow:hidden}
.dock-tabs .dock-collapse{margin-left:auto}
.dock-collapse{width:24px;height:24px;font-size:14px;border:1px solid var(--border);border-radius:6px;background:var(--surface-2);color:var(--muted);display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto}
.dock-collapse:hover{color:var(--accent);border-color:var(--accent)}
.project-context .project-action{margin:0 0 0 2px}
/* Highlighted code editor: a colored <pre> behind a transparent textarea. */
.editor-stack{position:relative;flex:1 1 auto;min-height:0;display:flex}
.code-highlight{position:absolute;inset:0;margin:0;padding:10px 12px;overflow:auto;white-space:pre;tab-size:4;pointer-events:none;font:var(--font-size)/1.55 var(--code-font);color:var(--text);border:0;background:transparent}
.editor-stack .file-editor{position:relative;z-index:1;color:transparent;background:transparent;caret-color:var(--text);flex:1 1 auto;border:0;margin:0;padding:10px 12px;font:var(--font-size)/1.55 var(--code-font);white-space:pre;tab-size:4;resize:none;overflow:auto}
.code-highlight .tok-key{color:#c792ea}
.code-highlight .tok-str{color:#c3e88d}
.code-highlight .tok-num{color:#f78c6c}
.code-highlight .tok-com{color:#676e95;font-style:italic}
.code-highlight .tok-fn{color:#82aaff}
.code-highlight .tok-op{color:#89ddff}
.code-highlight .tok-tag{color:#f07178}
.code-highlight .tok-attr{color:#ffcb6b}
html[data-theme="light"] .code-highlight .tok-key,html[data-theme="sepia"] .code-highlight .tok-key{color:#8b2bbf}
html[data-theme="light"] .code-highlight .tok-str,html[data-theme="sepia"] .code-highlight .tok-str{color:#3d7a1f}
html[data-theme="light"] .code-highlight .tok-num,html[data-theme="sepia"] .code-highlight .tok-num{color:#b5541f}
html[data-theme="light"] .code-highlight .tok-com,html[data-theme="sepia"] .code-highlight .tok-com{color:#8a8a8a}
html[data-theme="light"] .code-highlight .tok-fn,html[data-theme="sepia"] .code-highlight .tok-fn{color:#1f5fbf}
html[data-theme="light"] .code-highlight .tok-tag,html[data-theme="sepia"] .code-highlight .tok-tag{color:#c0392b}
html[data-theme="light"] .code-highlight .tok-attr,html[data-theme="sepia"] .code-highlight .tok-attr{color:#a8730a}
html[data-theme="graphite"]{--bg:#151515;--surface:#1c1c1e;--surface-2:#242426;--surface-3:#2c2c30;--hover:#323236;--border:#343438;--text:#eeeeef;--muted:#9a9a9f;--subtle:#727278;--accent:#c2c1d0;--accent-strong:#78758b;--accent-bg:#35343e}
html[data-theme="nord"]{--bg:#242a35;--surface:#2e3440;--surface-2:#343c4a;--surface-3:#3b4555;--hover:#414d60;--border:#455267;--text:#eceff4;--muted:#a3b1c6;--subtle:#8796ab;--accent:#88c0d0;--accent-strong:#4c91a5;--accent-bg:#304d5e}
html[data-theme="forest"]{--bg:#141b18;--surface:#1a231e;--surface-2:#202d25;--surface-3:#2a372d;--hover:#324334;--border:#34473b;--text:#e0e8de;--muted:#95a491;--subtle:#738574;--accent:#a1c79b;--accent-strong:#5b8354;--accent-bg:#30452f}
html[data-theme="light"]{--bg:#f7f7fb;--surface:#ffffff;--surface-2:#f1f2f7;--surface-3:#e8e9f0;--hover:#e7e7f3;--border:#dddfe9;--text:#262534;--muted:#6a697c;--subtle:#818294;--accent:#6559cd;--accent-strong:#6559cd;--accent-bg:#eeebff;--green:#287858;--red:#be3e55;--amber:#906324;color-scheme:light}
html[data-theme="sepia"]{--bg:#f4efe5;--surface:#fbf7ef;--surface-2:#eee7db;--surface-3:#e6ddce;--hover:#e5dbca;--border:#d9cbb7;--text:#403626;--muted:#80705d;--subtle:#95836e;--accent:#916432;--accent-strong:#986838;--accent-bg:#efe0c7;--green:#51743e;--red:#ae4f46;--amber:#956621;color-scheme:light}
html[data-font-size="small"]{--font-size:12px}html[data-font-size="large"]{--font-size:15px}html[data-font-size="extra-large"]{--font-size:17px}
*{box-sizing:border-box}body{margin:0;overflow:hidden;background:var(--bg);color:var(--text);font:var(--font-size)/1.5 'Segoe UI',Tahoma,Arial,sans-serif;height:100dvh;display:flex;flex-direction:column}button,input,textarea,select{font:inherit}button{cursor:pointer}button,a,input,textarea,select{outline:none}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--accent);outline-offset:2px}button{color:var(--text);border:0;background:transparent}button:disabled{opacity:.45;cursor:not-allowed}button:hover:not(:disabled){background:var(--hover)}[hidden]{display:none!important}svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}input,select,textarea{color:var(--text);background:var(--bg);border:1px solid var(--border);border-radius:6px;min-width:0}input,select{height:34px;padding:5px 9px}textarea{padding:10px;resize:vertical}select{cursor:pointer}input::placeholder,textarea::placeholder{color:var(--subtle)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.muted{color:var(--muted)}.primary,.secondary{border-radius:6px;padding:8px 12px;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:7px;font-size:.92em}.primary{background:var(--accent-strong);color:#fff;border:1px solid transparent;font-weight:600}.primary:hover:not(:disabled){background:var(--accent);color:var(--bg)}.secondary{border:1px solid var(--border);background:var(--surface-2)}.text-button{color:var(--muted);padding:7px 2px;font-size:.92em}.danger-text{color:var(--red)}.icon-button{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:6px;width:32px;height:32px;font-size:18px;color:var(--muted)}.icon-button:hover{color:var(--text)}.icon-button.small{width:25px;height:25px;font-size:16px}.button-row{display:flex;gap:7px;align-items:center}.button-row>*{flex:1;min-width:0}kbd{font:10px var(--code-font);color:var(--subtle);white-space:nowrap}.eyebrow{font-size:10px;letter-spacing:1.35px;color:var(--subtle);font-weight:600}.app-header{height:57px;flex:none;display:flex;align-items:center;gap:11px;padding:0 13px;border-bottom:1px solid var(--border);background:var(--surface);direction:ltr;z-index:5}.wordmark{display:flex;align-items:center;color:var(--text);text-decoration:none;font-size:17px;font-weight:650;letter-spacing:-.45px;white-space:nowrap}.wordmark>span:not(.brand-symbol){font-weight:400;color:var(--muted)}.brand-symbol{font-size:25px;color:var(--accent);margin-right:8px;font-weight:400}.wordmark small{font-size:9px;letter-spacing:0;font-weight:400;color:var(--subtle);margin:3px 0 0 7px}.header-divider{width:1px;height:21px;background:var(--border);margin:0 2px}.connection-chip{display:flex;gap:7px;align-items:center;font-size:9px;letter-spacing:.65px;color:var(--muted);white-space:nowrap;padding:7px;border-radius:6px}.connection-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--subtle);flex:none}.connected .connection-dot{background:var(--green);box-shadow:0 0 0 3px color-mix(in srgb,var(--green) 10%,transparent)}.connecting .connection-dot{background:var(--amber)}.model-select{background:var(--surface-2);font-size:11px;min-width:98px;max-width:155px;height:30px;border-color:var(--border)}.project-context{display:flex;align-items:center;gap:7px;min-width:0;color:var(--muted);font-size:11px;overflow:hidden}.project-context>#projectTitle{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px}.branch-label{color:var(--accent);white-space:nowrap}.header-actions{margin-left:auto;display:flex;align-items:center;gap:7px;flex:none}.browser-button{display:flex;align-items:center;gap:8px;font-size:11px;border:1px solid var(--border);background:var(--surface-2);border-radius:6px;height:32px;padding:0 10px;white-space:nowrap}.browser-button svg{width:15px;height:15px;color:var(--accent)}.workspace{flex:1;min-height:0;display:flex;direction:ltr}.sidebar{width:var(--sidebar-width);flex:none;display:flex;flex-direction:column;background:var(--surface);border-right:1px solid var(--border);padding:17px 11px 0;min-height:0}.sidebar.collapsed{width:48px;padding:16px 6px 0}.sidebar.collapsed .sidebar-copy{display:none}.sidebar.collapsed .new-chat{justify-content:center;padding:0}.sidebar.collapsed .sidebar-item{justify-content:center;padding:8px 0}.sidebar.collapsed .access-row{flex-wrap:wrap;gap:6px;justify-content:center;padding:8px 0}.sidebar.collapsed .chat-list{margin-top:12px}.sidebar.collapsed .chat-item .chat-copy{display:none}.sidebar.collapsed .chat-item{padding:8px 0;justify-content:center}.new-chat{height:37px;width:100%;border:1px solid var(--border);background:var(--surface-2);border-radius:7px;display:flex;align-items:center;gap:9px;padding:0 11px;font-size:12px}.new-chat>span:first-child{font-size:20px;color:var(--accent)}.new-chat kbd{margin-left:auto}.sidebar-section{display:flex;align-items:center;justify-content:space-between;margin:24px 7px 7px;font-size:9px;font-weight:600;letter-spacing:1px;color:var(--subtle)}.sidebar-item{display:flex;align-items:center;gap:9px;padding:8px 9px;border-radius:6px;text-align:start;font-size:11px;width:100%;color:var(--muted)}.sidebar-item>span:first-child{font-size:17px}.sidebar-item .sidebar-copy{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.chat-list{flex:1;overflow-y:auto;min-height:40px}.chat-item{display:flex;gap:8px;width:100%;align-items:center;padding:9px 9px;border-radius:6px;font-size:11px;text-align:start;color:var(--muted);margin-bottom:3px}.chat-item.active{color:var(--text);background:var(--accent-bg)}.chat-item.active>.chat-icon{color:var(--accent)}.chat-copy{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sidebar-bottom{border-top:1px solid var(--border);padding-top:10px}.access-row{display:flex;align-items:center;gap:8px;padding:6px 8px;font-size:11px}.access-row>span:first-child{font-size:17px;color:var(--amber)}.switch{width:30px;height:17px;background:var(--surface-3);border:1px solid var(--border);border-radius:20px;position:relative;flex:none;padding:0}.switch::after{content:'';width:11px;height:11px;position:absolute;top:2px;left:2px;background:var(--muted);border-radius:50%;transition:transform .15s}.switch[aria-checked="true"]{background:var(--accent-strong);border-color:var(--accent-strong)}.switch[aria-checked="true"]::after{background:#fff;transform:translateX(13px)}.access-row .switch{margin-left:auto}.access-warning{font-size:10px;color:var(--subtle);padding:0 9px 8px;margin:0;line-height:1.6}.sidebar-footer{height:37px;display:flex;align-items:center;gap:7px;font-size:9px;color:var(--subtle);padding:0 9px;margin-top:7px}.local-dot{width:4px;height:4px;border-radius:50%;background:var(--green)}.chat-panel{flex:1;min-width:300px;display:flex;flex-direction:column;min-height:0;background:var(--bg)}.chat-toolbar{height:70px;flex:none;padding:17px 26px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid color-mix(in srgb,var(--border) 60%,transparent)}.chat-toolbar h1{font-size:13px;font-weight:500;margin:2px 0 0}.chat-toolbar .eyebrow{font-size:8px;letter-spacing:1px}.toolbar-actions{display:flex;gap:4px}.toolbar-actions .icon-button{font-size:17px}.chat-stream{flex:1;overflow:auto;padding:25px 28px;scroll-behavior:smooth}.welcome{max-width:475px;margin:clamp(28px,9vh,100px) auto 30px}.welcome-mark{width:49px;height:49px;background:var(--accent-bg);color:var(--accent);border:1px solid color-mix(in srgb,var(--accent) 25%,var(--border));border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:31px;margin-bottom:25px;box-shadow:0 6px 24px #0001}.welcome .eyebrow{font-size:9px}.welcome h2{font-size:clamp(22px,2.1vw,31px);font-weight:500;letter-spacing:-1px;line-height:1.3;margin:12px 0 18px;text-wrap:balance;white-space:pre-line}.welcome>p:not(.eyebrow){font-size:12px;color:var(--muted);line-height:1.85;max-width:380px}.welcome-actions{display:flex;gap:9px;margin-top:25px;flex-wrap:wrap}.welcome-actions button{font-size:11px}.welcome-note{display:flex;gap:9px;color:var(--subtle);font-size:10px;line-height:1.7;margin-top:24px;max-width:360px}.welcome-note>span:first-child{font-size:15px;color:var(--accent)}.message{margin:0 0 27px;min-width:0}.message-header{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--muted);margin-bottom:10px}.avatar{width:25px;height:25px;display:inline-flex;align-items:center;justify-content:center;border-radius:7px;background:var(--surface-3);color:var(--text);font-size:13px}.assistant .avatar{background:var(--accent-bg);color:var(--accent)}.message-header time{margin-inline-start:auto;color:var(--subtle);font-size:9px}.message-body{font-size:1em;line-height:1.8;overflow-wrap:anywhere;padding-inline-start:33px}.user .message-body{color:var(--text)}.message-body p{margin:0 0 12px;white-space:pre-wrap}.message-body h1,.message-body h2,.message-body h3,.message-body h4{font-size:1.15em;margin:15px 0 8px}.message-body ul,.message-body ol{padding-inline-start:22px}.message-body blockquote{margin:12px 0;padding:2px 13px;border-inline-start:2px solid var(--accent);color:var(--muted)}.message-body pre,.operation-detail pre{background:var(--surface);border:1px solid var(--border);padding:12px;border-radius:7px;overflow:auto;font:.9em/1.7 var(--code-font);direction:ltr;text-align:left;white-space:pre}.message-body code{font:.9em var(--code-font);color:var(--accent);background:var(--surface-2);padding:2px 4px;border-radius:3px}.message-body pre code{padding:0;background:none;color:var(--text)}.code-caption{color:var(--subtle);font-size:9px;display:flex;align-items:center;justify-content:space-between}.code-caption button{color:var(--muted);font-size:10px}.message-body a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}.table-wrap{overflow:auto;margin:14px 0}.message-body table{border-collapse:collapse;font-size:.9em;min-width:100%}.message-body th,.message-body td{padding:7px 10px;border:1px solid var(--border);text-align:start}.message-body th{background:var(--surface-2)}.thinking{margin:0 0 11px 33px;color:var(--muted);font-size:11px}.thinking summary{cursor:pointer;color:var(--accent);font-size:10px}.thinking pre{white-space:pre-wrap;font:inherit;line-height:1.7;max-height:210px;overflow:auto;padding:10px;background:var(--surface);border-radius:6px}.operations{margin-inline-start:33px;font-size:11px}.operation-row{display:flex;gap:8px;align-items:flex-start;width:100%;padding:9px 10px;border:1px solid var(--border);border-radius:7px;margin:6px 0;text-align:start;background:var(--surface)}.operation-row .operation-icon{color:var(--accent);font:13px var(--code-font)}.operation-copy{min-width:0;flex:1}.operation-copy b{font-weight:600;color:var(--accent)}.operation-target{overflow-wrap:anywhere;font-family:var(--code-font);font-size:10px}.operation-subtitle{display:block;margin-top:3px;color:var(--muted);font-size:10px}.operation-state{color:var(--green);font-size:10px}.operation-row.failed{border-color:color-mix(in srgb,var(--red) 45%,var(--border))}.operation-row.failed .operation-state,.operation-row.failed .operation-subtitle{color:var(--red)}.operation-history summary{padding:7px 0;cursor:pointer;color:var(--subtle);font-size:10px}.operation-detail{color:var(--muted);font-size:10px;overflow:auto}.file-chip{display:inline-flex;align-items:center;gap:7px;padding:6px 10px;border:1px solid var(--border);border-radius:6px;margin:4px;background:var(--surface);font-size:11px}.file-chip img{max-width:180px;max-height:140px;border-radius:5px}.message-files{margin-inline-start:33px}.limit-banner{background:color-mix(in srgb,var(--amber) 10%,var(--bg));border-bottom:1px solid var(--amber);color:var(--amber);padding:13px 24px;font-size:11px}.limit-banner button{margin-inline-start:10px;text-decoration:underline}.approval-host{max-height:220px;overflow:auto;padding:0 24px}.approval-card{border:1px solid var(--amber);border-radius:8px;padding:12px 14px;background:var(--surface);margin:0 0 10px;font-size:11px}.approval-card h4{margin:0 0 5px;color:var(--amber)}.approval-card p{margin:0 0 10px;overflow-wrap:anywhere}.approval-card pre{max-height:80px;overflow:auto;font:10px var(--code-font);white-space:pre-wrap}.approval-card .button-row{max-width:220px}.composer-wrap{padding:10px 24px 19px;flex:none}.composer{border:1px solid var(--border);border-radius:10px;background:var(--surface);box-shadow:0 3px 15px #0001}.composer:focus-within{border-color:color-mix(in srgb,var(--accent) 55%,var(--border))}.composer textarea{width:100%;border:0;background:transparent;min-height:61px;max-height:200px;resize:none;padding:15px 15px 5px;font-size:12px;line-height:1.65;outline:none}.composer-bottom{display:flex;align-items:center;padding:3px 10px 10px;gap:8px}.composer-status{font-size:9px;color:var(--subtle)}.send-button{margin-inline-start:auto;width:31px;height:31px;background:var(--accent-strong);border-radius:7px;color:#fff;font-size:20px}.send-button.busy{background:var(--surface-3);color:var(--red)}.composer-hint{display:flex;justify-content:space-between;gap:8px;color:var(--subtle);font-size:9px;margin-top:9px}.attachment-host{font-size:10px}.attachment-host .file-chip{margin:0 0 8px}.attachment-host .attachment-status{color:var(--amber)}.splitter{width:5px;flex:none;position:relative;cursor:col-resize;touch-action:none;user-select:none;background:var(--border);border-inline:2px solid var(--bg);z-index:4}.splitter:hover,.splitter.dragging{background:var(--accent)}.splitter::after{content:'';position:absolute;inset:0 -3px}.right-block{flex:none;width:var(--right-width);min-width:280px;display:flex;flex-direction:column;min-height:0;background:var(--surface);direction:ltr}.dock-tabs{height:43px;display:flex;align-items:stretch;border-bottom:1px solid var(--border);padding:0 8px;flex:none;gap:3px;overflow:auto;scrollbar-width:none}.dock-tab{font-size:10px;padding:0 9px;color:var(--muted);display:flex;gap:5px;align-items:center;white-space:nowrap;border-bottom:2px solid transparent}.dock-tab>span:first-child{font-size:13px}.dock-tab.active{color:var(--text);border-bottom-color:var(--accent);background:color-mix(in srgb,var(--accent) 4%,var(--surface))}.right-body{display:flex;min-height:0;flex:1;overflow:hidden}.browser-pane{width:var(--browser-width);flex:none;min-width:150px;display:flex;flex-direction:column;min-height:0}.browser-navigation{height:39px;flex:none;display:flex;align-items:center;gap:0;padding:5px 6px;background:var(--surface-2);border-bottom:1px solid var(--border)}.browser-navigation input{height:25px;font-size:9px;flex:1;padding:3px 6px;border-radius:4px;border-color:transparent;background:var(--bg)}.browser-navigation .icon-button{width:20px;font-size:14px}.ib-dock{flex:1;min-height:80px;position:relative;background:var(--bg);overflow:hidden}.dock-empty{height:100%;min-height:200px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:20px 17px}.browser-outline{width:87px;height:69px;color:var(--subtle);margin-bottom:29px;opacity:.75}.browser-outline svg{width:100%;height:100%;stroke-width:1.2}.dock-empty .eyebrow{font-size:8px;letter-spacing:1px}.dock-empty h2{font-size:16px;letter-spacing:-.3px;font-weight:500;margin:10px 0}.dock-empty p{font-size:11px;line-height:1.75;color:var(--muted);max-width:230px;margin:0 0 23px}.dock-empty .primary{font-size:10px}.demo-notice{font-size:8px;color:var(--subtle);line-height:1.6;margin-top:15px}.browser-foot{height:29px;flex:none;display:flex;align-items:center;gap:6px;border-top:1px solid var(--border);padding:0 8px;font-size:8px;color:var(--subtle)}.browser-foot #reinjectBtn{margin-left:auto}.browser-foot .icon-button{font-size:14px}.browser-log{font:9px/1.7 var(--code-font);color:var(--